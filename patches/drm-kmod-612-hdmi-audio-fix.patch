diff --git a/drivers/gpu/drm/i915/display/intel_audio.c b/drivers/gpu/drm/i915/display/intel_audio.c
index afa411e..c96316c 100644
--- a/drivers/gpu/drm/i915/display/intel_audio.c
+++ b/drivers/gpu/drm/i915/display/intel_audio.c
@@ -36,6 +36,7 @@
 #include "intel_cdclk.h"
 #include "intel_crtc.h"
 #include "intel_de.h"
+#include "intel_display_power.h"
 #include "intel_display_types.h"
 #include "intel_lpe_audio.h"
 
@@ -549,6 +550,29 @@ static void hsw_audio_codec_enable(struct intel_encoder *encoder,
 
 	mutex_lock(&i915->display.audio.mutex);
 
+	/*
+	 * FreeBSD has no i915/snd_hda audio component, so the power-up done
+	 * on Linux by i915_audio_component_get_power() and the AUD_FREQ_CNTRL
+	 * setup in i915_audio_component_init() (both #ifdef __linux__ in this
+	 * port) never run.  Without the HDA link clock the display-audio codec
+	 * at HDA address 2 never answers ("CODEC at address 2 not
+	 * responding!"), even when AUDIO_OUTPUT_ENABLE is set below.
+	 */
+	intel_display_power_get(i915, POWER_DOMAIN_AUDIO_PLAYBACK);
+	if (DISPLAY_VER(i915) >= 9) {
+		u32 freq = i915->display.audio.freq_cntrl;
+
+		if (!freq) {
+			if (DISPLAY_VER(i915) >= 12)
+				freq = 0x8010; /* AUD_FREQ_GEN12 */
+			else
+				freq = intel_de_read(i915, AUD_FREQ_CNTRL);
+		}
+		intel_de_write(i915, AUD_FREQ_CNTRL, freq);
+	}
+	if (DISPLAY_VER(i915) >= 10)
+		intel_de_rmw(i915, AUD_PIN_BUF_CTL, 0, AUD_PIN_BUF_ENABLE);
+
 	/* Enable Audio WA for 4k DSC usecases */
 	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DP))
 		enable_audio_dsc_wa(encoder, crtc_state);
