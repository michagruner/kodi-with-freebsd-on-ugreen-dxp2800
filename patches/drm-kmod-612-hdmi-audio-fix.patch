diff --git a/drivers/gpu/drm/i915/display/intel_audio.c b/drivers/gpu/drm/i915/display/intel_audio.c
index afa411e..835d4fd 100644
--- a/drivers/gpu/drm/i915/display/intel_audio.c
+++ b/drivers/gpu/drm/i915/display/intel_audio.c
@@ -36,6 +36,7 @@
 #include "intel_cdclk.h"
 #include "intel_crtc.h"
 #include "intel_de.h"
+#include "intel_display_power.h"
 #include "intel_display_types.h"
 #include "intel_lpe_audio.h"
 
@@ -549,6 +550,19 @@ static void hsw_audio_codec_enable(struct intel_encoder *encoder,
 
 	mutex_lock(&i915->display.audio.mutex);
 
+	/*
+	 * FreeBSD has no audio component, so the power-up done on Linux by
+	 * i915_audio_component_get_power() never happens.  Without the HDA
+	 * link clock the display-audio codec at HDA address 2 never answers,
+	 * even though AUDIO_OUTPUT_ENABLE is set below.
+	 */
+	intel_display_power_get(i915, POWER_DOMAIN_AUDIO_PLAYBACK);
+	if (DISPLAY_VER(i915) >= 9)
+		intel_de_write(i915, AUD_FREQ_CNTRL,
+			       i915->display.audio.freq_cntrl);
+	if (DISPLAY_VER(i915) >= 10)
+		intel_de_rmw(i915, AUD_PIN_BUF_CTL, 0, AUD_PIN_BUF_ENABLE);
+
 	/* Enable Audio WA for 4k DSC usecases */
 	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DP))
 		enable_audio_dsc_wa(encoder, crtc_state);
@@ -1355,6 +1369,14 @@ void intel_audio_init(struct drm_i915_private *i915)
 	// No lpe on BSD yet
 	if (intel_lpe_audio_init(i915) < 0)
 		i915_audio_component_init(i915);
+#else
+	/*
+	 * There is no i915/snd_hda audio component on FreeBSD, but the part
+	 * of i915_audio_component_init() which computes
+	 * display.audio.freq_cntrl (AUD_FREQ_CNTRL) and updates the cdclk
+	 * constraints is required for display audio to work.
+	 */
+	i915_audio_component_init(i915);
 #endif
 }
 
