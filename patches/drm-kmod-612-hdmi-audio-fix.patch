diff --git a/drivers/gpu/drm/i915/display/intel_audio.c b/drivers/gpu/drm/i915/display/intel_audio.c
index afa411e..839eb4c 100644
--- a/drivers/gpu/drm/i915/display/intel_audio.c
+++ b/drivers/gpu/drm/i915/display/intel_audio.c
@@ -36,6 +36,7 @@
 #include "intel_cdclk.h"
 #include "intel_crtc.h"
 #include "intel_de.h"
+#include "intel_display_power.h"
 #include "intel_display_types.h"
 #include "intel_lpe_audio.h"
 
@@ -549,6 +550,28 @@ static void hsw_audio_codec_enable(struct intel_encoder *encoder,
 
 	mutex_lock(&i915->display.audio.mutex);
 
+	/*
+	 * FreeBSD has no audio component, so the power-up normally done by
+	 * snd_hda via i915_audio_component_get_power() never happens:
+	 *  - enable POWER_DOMAIN_AUDIO_PLAYBACK,
+	 *  - restore AUD_FREQ_CNTRL (FreeBSD's intel_audio_init() is a no-op,
+	 *    so display.audio.freq_cntrl is 0; use the Linux GEN12 value
+	 *    0x8010 = AUD_FREQ_8T | AUD_FREQ_BCLK_96M),
+	 *  - enable AUD_PIN_BUF_CTL.
+	 * Without the HDA link clock the display-audio codec at HDA address 2
+	 * never answers and snd_hda reports "CODEC at address 2 not responding!".
+	 */
+	intel_display_power_get(i915, POWER_DOMAIN_AUDIO_PLAYBACK);
+	if (DISPLAY_VER(i915) >= 9) {
+		u32 freq = i915->display.audio.freq_cntrl;
+
+		if (!freq)
+			freq = 0x8010; /* AUD_FREQ_GEN12 */
+		intel_de_write(i915, AUD_FREQ_CNTRL, freq);
+	}
+	if (DISPLAY_VER(i915) >= 10)
+		intel_de_rmw(i915, AUD_PIN_BUF_CTL, 0, AUD_PIN_BUF_ENABLE);
+
 	/* Enable Audio WA for 4k DSC usecases */
 	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DP))
 		enable_audio_dsc_wa(encoder, crtc_state);
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index e00fd36..7763367 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2196,17 +2196,12 @@ static bool intel_hdmi_has_audio(struct intel_encoder *encoder,
 				 const struct intel_crtc_state *crtc_state,
 				 const struct drm_connector_state *conn_state)
 {
-	struct drm_connector *connector = conn_state->connector;
-	const struct intel_digital_connector_state *intel_conn_state =
-		to_intel_digital_connector_state(conn_state);
-
-	if (!crtc_state->has_hdmi_sink)
-		return false;
-
-	if (intel_conn_state->force_audio == HDMI_AUDIO_AUTO)
-		return connector->display_info.has_audio;
-	else
-		return intel_conn_state->force_audio == HDMI_AUDIO_ON;
+	/*
+	 * FreeBSD has no i915/snd_hda audio component, so nothing will ever
+	 * flip the connector's audio state or force_audio property.  Report
+	 * audio support for HDMI sinks so intel_audio_codec_enable() runs.
+	 */
+	return true;
 }
 
 static enum intel_output_format
