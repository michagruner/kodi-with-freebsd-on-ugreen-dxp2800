#!/bin/sh
# PROVIDE: kodidisplay
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="kodidisplay"
rcvar="kodidisplay_enable"
LOCK=/var/run/kodidisplay.lock

start_cmd="${name}_start"
stop_cmd="${name}_stop"

kodidisplay_start()
{
    if ! mkdir "$LOCK" 2>/dev/null; then
        echo "kodidisplay: already running/starting"
        return 0
    fi
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT

    if pgrep -q -f "Xorg :0"; then
        echo "kodidisplay: Xorg already running"
    else
        echo "Starting Xorg"
        rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock
        /usr/sbin/daemon -o /var/log/kodi-xorg.log -p /var/run/kodi-xorg.pid \
            /usr/local/libexec/Xorg :0 vt7 -nolisten tcp -ac
        sleep 5
        i=0
        while [ "$i" -lt 15 ]; do
            if timeout 5 env DISPLAY=:0 /usr/local/bin/xrandr 2>/dev/null | grep -q "^HDMI-1 connected primary [0-9]"; then
                break
            fi
            sleep 1
            i=$((i+1))
        done
    fi

    # HDMI audio: i915 must have enabled display audio before hdac re-probes
    timeout 60 /usr/local/bin/hdmi-audio-reprobe

    # Only start Kodi when there is an active HDMI output; if the TV is off,
    # the watchdog starts Kodi once the TV comes on.
    if timeout 5 env DISPLAY=:0 /usr/local/bin/xrandr 2>/dev/null | grep -q "^HDMI-1 connected primary [0-9]"; then
        if ! pgrep -q -f "kodi.bin"; then
            echo "Starting Kodi"
            /usr/sbin/daemon -o /var/log/kodi-run.log -p /var/run/kodi.pid \
                /usr/bin/env DISPLAY=:0 HOME=/root /usr/local/bin/kodi
        fi
    else
        echo "kodidisplay: HDMI not active (TV off?) - watchdog starts Kodi when TV is on"
    fi
}

kodidisplay_stop()
{
    echo "Stopping Kodi + Xorg"
    [ -f /var/run/kodi.pid ] && kill "$(cat /var/run/kodi.pid)" 2>/dev/null
    sleep 2
    [ -f /var/run/kodi-xorg.pid ] && kill "$(cat /var/run/kodi-xorg.pid)" 2>/dev/null
    sleep 2
    if ! pgrep -q -f "Xorg :0"; then rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock; fi
    rmdir "$LOCK" 2>/dev/null
}

load_rc_config $name
: ${kodidisplay_enable:="NO"}
run_rc_command "$1"
